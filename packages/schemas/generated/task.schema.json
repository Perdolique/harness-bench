{
  "type": "object",
  "properties": {
    "document_type": {
      "const": "task"
    },
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "collector": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "revision",
        "image_digest"
      ],
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "network_enforcement_sidecar_digest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "known"
                },
                "value": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "status",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "not_applicable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "revision",
        "image_digest",
        "network_enforcement_sidecar_digest"
      ],
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "rubric_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision",
        "rubric_revision"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "additionalProperties": false
    },
    "declared_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "facet": {
            "enum": [
              "direct_behavior",
              "repository_contracts",
              "regression",
              "scope_integrity",
              "maintainability"
            ],
            "type": "string"
          },
          "expectation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "deterministic_check": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "enum": [
              "required",
              "optional"
            ],
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "obligation_id",
          "facet",
          "expectation",
          "evidence_paths",
          "deterministic_check",
          "applicability",
          "weight"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "allowed",
        "conditional",
        "forbidden"
      ],
      "additionalProperties": false
    },
    "online_reachability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "eligible",
            "ineligible",
            "unknown"
          ],
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "retention": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "classification": {
              "const": "public"
            },
            "expires_at": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "not_applicable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "classification",
            "expires_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "classification": {
              "const": "private"
            },
            "default_days": {
              "const": 90
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "classification",
            "default_days",
            "expires_at"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "task_id",
    "revision",
    "base_commit",
    "source_digest",
    "environment",
    "collector",
    "verifier",
    "scoring",
    "prompt",
    "declared_artifacts",
    "rubric",
    "scope",
    "online_reachability",
    "retention"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-stack-benchmark.local/v1/task.schema.json",
  "title": "Task document v1",
  "description": "Frozen task, verifier, rubric, and retention contract"
}
