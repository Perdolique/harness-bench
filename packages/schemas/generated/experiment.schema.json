{
  "type": "object",
  "properties": {
    "document_type": {
      "const": "experiment"
    },
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "analysis_revision": {
      "type": "string",
      "minLength": 1
    },
    "comparison_kind": {
      "const": "harness_effect"
    },
    "suite": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "arm_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "stack": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "additionalProperties": false
          },
          "harness": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "additionalProperties": false
          },
          "treatment": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "arm_id",
          "stack",
          "harness",
          "treatment"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "task_id",
          "revision",
          "source_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "ordering_seed": {
      "type": "integer",
      "minimum": 0
    },
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_attempts_per_arm": {
          "type": "integer",
          "minimum": 1
        },
        "retryable_classifications": {
          "type": "array",
          "items": {
            "enum": [
              "agent_failure",
              "provider_failure",
              "runner_failure",
              "verifier_failure",
              "infrastructure_failure"
            ],
            "type": "string"
          }
        }
      },
      "required": [
        "max_attempts_per_arm",
        "retryable_classifications"
      ],
      "additionalProperties": false
    },
    "execution_order": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "block_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "arm_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "replicate": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "sequence",
          "block_id",
          "arm_id",
          "task_id",
          "replicate"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "token_or_turn_limit": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "known"
                },
                "unit": {
                  "enum": [
                    "tokens",
                    "turns"
                  ],
                  "type": "string"
                },
                "value": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "status",
                "unit",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        },
        "cpu_count": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_enforcement_status": {
          "enum": [
            "enforced",
            "not_started",
            "failed"
          ],
          "type": "string"
        },
        "memory_megabytes": {
          "type": "integer",
          "minimum": 1
        },
        "memory_enforcement_status": {
          "enum": [
            "enforced",
            "not_started",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "wall_clock_seconds",
        "token_or_turn_limit",
        "cpu_count",
        "cpu_enforcement_status",
        "memory_megabytes",
        "memory_enforcement_status"
      ],
      "additionalProperties": false
    },
    "requested_concurrency": {
      "const": 1
    },
    "effective_concurrency": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "const": 1
            }
          },
          "required": [
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "concurrency_enforcement_status": {
      "enum": [
        "enforced",
        "not_started",
        "failed"
      ],
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "replicate": {
            "type": "integer",
            "minimum": 1
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "run_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                },
                "arm_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 1
                },
                "selected": {
                  "type": "boolean"
                }
              },
              "required": [
                "run_id",
                "arm_id",
                "attempt",
                "selected"
              ],
              "additionalProperties": false
            }
          },
          "first_started_at": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "known"
                  },
                  "value": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "status",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "status",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          },
          "deadline_at": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "known"
                  },
                  "value": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "status",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "status",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "known"
                  },
                  "value": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "status",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "status",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          },
          "completion_status": {
            "enum": [
              "planned",
              "in_progress",
              "completed",
              "invalidated"
            ],
            "type": "string"
          },
          "contemporaneity": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "pending"
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "eligible"
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "ineligible"
                  },
                  "cause": {
                    "enum": [
                      "incomplete",
                      "deadline_exceeded",
                      "model_changed",
                      "cli_changed",
                      "provider_changed",
                      "runner_changed",
                      "harbor_config_changed",
                      "harness_changed"
                    ],
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "status",
                  "cause",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "block_id",
          "task_id",
          "replicate",
          "runs",
          "first_started_at",
          "deadline_at",
          "completed_at",
          "completion_status",
          "contemporaneity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "experiment_id",
    "revision",
    "plan_digest",
    "analysis_revision",
    "comparison_kind",
    "suite",
    "arms",
    "tasks",
    "repeats",
    "ordering_seed",
    "retry_policy",
    "execution_order",
    "budget",
    "requested_concurrency",
    "effective_concurrency",
    "concurrency_enforcement_status",
    "blocks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-stack-benchmark.local/v1/experiment.schema.json",
  "title": "Experiment document v1",
  "description": "Immutable experiment plan and block-status contract"
}
