{
  "type": "object",
  "properties": {
    "document_type": {
      "const": "suite"
    },
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "task_id",
          "revision",
          "source_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "suite_id",
    "revision",
    "digest",
    "tasks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-stack-benchmark.local/v1/suite.schema.json",
  "title": "Suite document v1",
  "description": "Frozen benchmark suite identity contract"
}
